@api.route('/content/dynamic-sections/<int:section_id>', methods=['DELETE'])
@jwt_required()
def delete_dynamic_section(section_id):
    try:
        section = DynamicSection.query.get(section_id)
        if not section:
            response = jsonify({'success': False, 'error': 'Section not found'})
            response.status_code = 404
            return add_cors_headers(response)
        
        db.session.delete(section)
        db.session.commit()
        
        response = jsonify({'success': True, 'message': 'Section deleted successfully'})
        return add_cors_headers(response)
    except Exception as e:
        db.session.rollback()
        current_app.logger.error(f"Error deleting section: {str(e)}")
        response = jsonify({'success': False, 'error': str(e)})
        response.status_code = 500
        return add_cors_headers(response)
